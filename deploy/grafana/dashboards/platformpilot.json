{
 "title": "PlatformPilot",
 "uid": "platformpilot",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Root-cause accuracy (eval)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "platformpilot_eval_root_cause_accuracy",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Fix accuracy (eval)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "platformpilot_eval_fix_accuracy",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "MTTD agent (min)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "platformpilot_eval_mttd_minutes",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "MTTD manual baseline (min, modeled)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "platformpilot_eval_mttd_manual_minutes",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Agent runs by outcome",
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(platformpilot_runs_total[5m]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Diagnosis latency p95 (s)",
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(platformpilot_diagnosis_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Tool calls by tool",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (tool) (increase(platformpilot_tool_calls_total[5m]))",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Agent CPU % / RSS MB",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "platformpilot_process_cpu_percent",
     "legendFormat": "cpu %",
     "refId": "A"
    },
    {
     "expr": "platformpilot_process_rss_mb",
     "legendFormat": "rss MB",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ]
}